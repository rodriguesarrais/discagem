# Public hostname of the server (a DNS A/AAAA record must point to the VPS).
DISCAGEM_DOMAIN=chat.example.com

# Released server image to run instead of building from source (see the GitHub releases page).
# Pin a version, or use "latest" for the newest stable release.
# DISCAGEM_IMAGE=ghcr.io/rodriguesarrais/discagem-server:latest

# Name shown to clients.
Discagem__ServerName=Discagem

# Required to create accounts. Share it only with the people you want on the server.
# If empty, only the very first account (the administrator) can be created.
Discagem__InviteCode=change-me-to-a-long-random-string

# Only needed when the VPS sits behind 1:1 NAT and its network interface has a private
# address (AWS, Google Cloud, Oracle Cloud...). Set it to the instance's public IP.
# Discagem__Media__PublicIpAddress=203.0.113.10

# Optional overrides.
# Discagem__MaxUploadBytes=26214400
# Discagem__Media__RtpPortStart=50000
# Discagem__Media__RtpPortEnd=50999
# Discagem__Media__StunPort=3478
# Discagem__Media__MaxViewersPerStream=25
