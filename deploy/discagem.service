# systemd unit for running the server without Docker.
#
#   dotnet publish src/Discagem.Server -c Release -r linux-x64 --self-contained -o /opt/discagem
#   sudo useradd --system --home /var/lib/discagem --create-home discagem
#   sudo cp deploy/discagem.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now discagem
#
# Put a TLS reverse proxy (Caddy, nginx) in front of 127.0.0.1:5080.

[Unit]
Description=Discagem chat and screen sharing server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discagem
WorkingDirectory=/opt/discagem
ExecStart=/opt/discagem/Discagem.Server
Restart=on-failure
RestartSec=5
Environment=Urls=http://127.0.0.1:5080
Environment=Discagem__DataDirectory=/var/lib/discagem
# Keep secrets out of the unit file:
EnvironmentFile=-/etc/discagem.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/discagem

[Install]
WantedBy=multi-user.target
