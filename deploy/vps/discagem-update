#!/usr/bin/env bash
# Updates the Discagem server to the latest published image: backs up the data volume, pulls the
# image, recreates only the Discagem container and waits until it answers again.
#
# Install it as /usr/local/bin/discagem-update and describe the Compose project in
# /etc/discagem-update.conf (see README, "Automatic deployment"):
#
#   COMPOSE_DIR=/docker/discagem     # folder holding the project's docker-compose.yml
#   SERVICE=discagem                 # the server's service name in that file
#   HEALTH_URL=http://127.0.0.1:5080/health
#   BACKUP_DIR=/var/backups/discagem # empty to skip the backup
#   BACKUPS_TO_KEEP=5
#
# The Release workflow runs it over SSH with a key that can do nothing else (a forced command in
# authorized_keys). It can also be run by hand.
set -euo pipefail

CONFIG=${DISCAGEM_UPDATE_CONFIG:-/etc/discagem-update.conf}
if [[ -r "$CONFIG" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG"
fi

COMPOSE_DIR=${COMPOSE_DIR:?set COMPOSE_DIR in $CONFIG}
SERVICE=${SERVICE:-discagem}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:5080/health}
BACKUP_DIR=${BACKUP_DIR-/var/backups/discagem}
BACKUPS_TO_KEEP=${BACKUPS_TO_KEEP:-5}

log() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*"; }

# Only one update at a time (two releases in a row, or a manual run during an automatic one).
exec 9> /tmp/discagem-update.lock
flock -w 600 9 || { log "Another update is still running."; exit 1; }

cd "$COMPOSE_DIR"
compose() { docker compose "$@"; }

container=$(compose ps -q "$SERVICE" || true)
if [[ -n "$BACKUP_DIR" && -n "$container" ]]; then
  # Back up the volume mounted at /data (database, uploads, avatars and the token signing key).
  volume=$(docker inspect "$container" --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}')
  if [[ -n "$volume" ]]; then
    mkdir -p "$BACKUP_DIR"
    archive="$BACKUP_DIR/discagem-data-$(date -u +%Y%m%d-%H%M%S).tar.gz"
    log "Backing up volume $volume to $archive"
    image=$(docker inspect "$container" --format '{{.Config.Image}}')
    docker run --rm --user 0 --entrypoint tar -v "$volume":/data:ro -v "$BACKUP_DIR":/backup "$image" \
      czf "/backup/$(basename "$archive")" -C /data .
    # Keep the newest backups only.
    find "$BACKUP_DIR" -maxdepth 1 -name 'discagem-data-*.tar.gz' -printf '%T@ %p\n' | sort -rn |
      tail -n +"$((BACKUPS_TO_KEEP + 1))" | cut -d' ' -f2- | xargs -r rm -f
  fi
fi

log "Pulling the latest image"
compose pull "$SERVICE"

log "Recreating $SERVICE (calls and streams reconnect on their own)"
compose up -d "$SERVICE"

log "Waiting for $HEALTH_URL"
for _ in $(seq 60); do
  if curl -fsS -m 5 "$HEALTH_URL" > /dev/null 2>&1; then
    version=$(curl -fsS -m 5 "${HEALTH_URL%/health}/" || true)
    log "Up: ${version:-Discagem server}"
    docker image prune -f > /dev/null || true
    exit 0
  fi
  sleep 2
done

log "The server did not come back; recent log:"
compose logs --tail 50 "$SERVICE" || true
exit 1
