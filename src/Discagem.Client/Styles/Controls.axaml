<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Discagem.Client.Controls">

  <!-- Typography -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource RailBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#FF8A8F" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Icons -->
  <Style Selector="c|Icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#4A4580" />
    <Setter Property="Foreground" Value="#B8B3E6" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C93A3F" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.live">
    <Setter Property="Background" Value="{StaticResource LiveBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.live:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D93644" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Buttons without chrome (images, custom content) -->
  <Style Selector="Button.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.bare:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Square icon buttons used in headers and toolbars -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Button.icon.small c|Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.icon.danger-hover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#FF8A8F" />
  </Style>
  <Style Selector="ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- Text inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="SelectionBrush" Value="#807C6CFF" />
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.composer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,11" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MaxHeight" Value="220" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement, TextBox.composer:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Channel list -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
  </Style>

  <!-- Clickable rows (members, live streams) -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.row:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Voice channels -->
  <Style Selector="Button.voice-channel">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.voice-channel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.voice-channel.connected">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.voice-channel.connected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
  </Style>
  <Style Selector="Border.voice-participant">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.voice-participant:pointerover">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="TextBlock.voice-name">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.voice-name.speaking">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon.panel">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="RadioButton.choice">
    <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.choice:checked">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
  </Style>

  <Style Selector="ProgressBar.meter">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="ProgressBar.meter.active">
    <Setter Property="Foreground" Value="{StaticResource OnlineBrush}" />
  </Style>

  <!-- Cards and badges -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 12 40 0 #66000000" />
  </Style>
  <Style Selector="Border.live-badge">
    <Setter Property="Background" Value="{StaticResource LiveBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.live-badge TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>
  <Style Selector="Border.count-badge">
    <Setter Property="Background" Value="{StaticResource LiveBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="Border.count-badge TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Message rows -->
  <Style Selector="Border.message">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.message:pointerover">
    <Setter Property="Background" Value="#202127" />
  </Style>
  <Style Selector="Border.message.mention">
    <Setter Property="Background" Value="#1F7C6CFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Border.message :is(Control).hover-only">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.message:pointerover :is(Control).hover-only">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #40000000" />
  </Style>

  <!-- Typing indicator dots -->
  <!-- Infinite animations only run under the "animated" class, which views bind to the same condition
       as visibility: a hidden control keeps animating, and every frame triggers a redraw. -->
  <Style Selector="Ellipse.typing-dot">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Ellipse.typing-dot.animated">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
        <KeyFrame Cue="40%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="80%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Ellipse.typing-dot.second.animated">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" Delay="0:0:0.2">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
        <KeyFrame Cue="40%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="80%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.typing-dot.third.animated">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" Delay="0:0:0.4">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
        <KeyFrame Cue="40%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="80%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Stream overlay controls fade in on hover -->
  <Style Selector="Border.stream-overlay">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.stream-surface:pointerover Border.stream-overlay">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Grid.stream-surface.no-frame Border.stream-overlay">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Live indicator pulse -->
  <Style Selector="Ellipse.pulse.animated">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Screen picker tiles -->
  <Style Selector="ListBox.tiles">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Tabs in dialogs -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource DividerBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#111214" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
</Styles>
