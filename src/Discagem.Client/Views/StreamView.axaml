<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Discagem.Client.ViewModels"
             xmlns:c="using:Discagem.Client.Controls"
             x:Class="Discagem.Client.Views.StreamView"
             x:DataType="vm:StreamViewerViewModel">
  <Grid Classes="stream-surface" Classes.no-frame="{Binding !HasFrame}" Background="#0B0B0E" DoubleTapped="OnDoubleTapped">
    <Image Source="{Binding Frame}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsVisible="{Binding !HasFrame}" MaxWidth="420">
      <c:AvatarView Width="72" Height="72" DisplayName="{Binding Stream.Streamer.DisplayName}" Color="{Binding Stream.Streamer.AvatarColor}"
                    HorizontalAlignment="Center" />
      <ProgressBar IsIndeterminate="True" Width="120" Height="3" MinHeight="3" Foreground="{StaticResource AccentBrush}" />
      <TextBlock Text="{Binding Status}" Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Top overlay -->
    <Border Classes="stream-overlay" VerticalAlignment="Top" Padding="14,10,10,22">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#D9000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:AvatarView Width="32" Height="32" DisplayName="{Binding Stream.Streamer.DisplayName}" Color="{Binding Stream.Streamer.AvatarColor}"
                      VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Stream.Streamer.DisplayName}" FontWeight="Bold" Foreground="White" />
            <Border Classes="live-badge">
              <TextBlock Text="LIVE" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Stream.DisplayTitle}" FontSize="12.5" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatsText}" FontSize="11.5" Foreground="#B3FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,0"
                      ToolTip.Tip="Viewers">
            <c:Icon Data="{StaticResource IconEye}" Width="15" Height="15" Foreground="#CCFFFFFF" />
            <TextBlock Text="{Binding Stream.ViewerCount}" Foreground="#CCFFFFFF" FontSize="12.5" />
          </StackPanel>
          <Button Classes="icon" Foreground="White" ToolTip.Tip="Open in a separate window" Click="OnPopOutClick" x:Name="PopOutButton">
            <c:Icon Data="{StaticResource IconPopOut}" />
          </Button>
          <Button Classes="icon" Foreground="White" ToolTip.Tip="Full screen" Click="OnFullScreenClick">
            <c:Icon Data="{StaticResource IconFullscreen}" />
          </Button>
          <Button Classes="icon" Foreground="White" ToolTip.Tip="Stop watching" Command="{Binding CloseCommand}">
            <c:Icon Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
