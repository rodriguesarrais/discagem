<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Discagem.Client.ViewModels"
        xmlns:c="using:Discagem.Client.Controls"
        x:Class="Discagem.Client.Views.Dialogs.UploadExpressionDialog"
        x:DataType="vm:UploadExpressionViewModel"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ChatBrush}"
        Title="{Binding Heading}">
  <StackPanel>
    <StackPanel Margin="20,20,20,24" Spacing="18">
      <TextBlock Text="{Binding Heading}" Classes="h2" />

      <Grid ColumnDefinitions="Auto,*">
        <Border Width="96" Height="96" CornerRadius="8" Background="{DynamicResource SidebarBrush}" Margin="0,0,16,0"
                IsVisible="{Binding HasImage}">
          <Image Source="{Binding Image}" Stretch="Uniform" Margin="8" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
        <Button Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" Classes="icon" IsVisible="{Binding CanPreview}"
                Command="{Binding PlayPreviewCommand}" ToolTip.Tip="Listen (only you hear it)" VerticalAlignment="Top">
          <c:Icon Data="{StaticResource IconPlay}" Width="24" Height="24" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Details}" Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>

      <StackPanel>
        <TextBlock Text="{Binding Label}" Classes="label" />
        <TextBox Text="{Binding Name}" x:Name="NameBox" MaxLength="{Binding MaxLength}" />
        <TextBlock Text="{Binding Preview}" Classes="caption" Margin="2,6,0,0"
                   IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>
    <Border Background="{DynamicResource SidebarBrush}" Padding="16,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
        <Button Classes="primary" Content="Add" Click="OnConfirm" IsDefault="True" IsEnabled="{Binding CanConfirm}" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
