<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Discagem.Client.Views.Dialogs.ConfirmDialog"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ChatBrush}"
        Title="Discagem">
  <StackPanel>
    <StackPanel Margin="20,20,20,24" Spacing="12">
      <TextBlock x:Name="HeadingText" Classes="h2" />
      <TextBlock x:Name="MessageText" Classes="secondary" TextWrapping="Wrap" />
    </StackPanel>
    <Border Background="{StaticResource SidebarBrush}" Padding="16,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
        <Button x:Name="ConfirmButton" Classes="primary" Click="OnConfirm" IsDefault="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
