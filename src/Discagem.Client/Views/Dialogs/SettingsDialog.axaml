<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Discagem.Client.ViewModels"
        xmlns:c="using:Discagem.Client.Controls"
        xmlns:media="using:Discagem.Media.Pipeline"
        xmlns:audio="using:Discagem.Client.Services.Audio"
        xmlns:views="using:Discagem.Client.Views"
        x:Class="Discagem.Client.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Width="620" Height="680" MinWidth="520" MinHeight="480" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ChatBrush}"
        Title="User settings">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Margin="28,24,28,24" Spacing="28">

        <!-- Profile -->
        <StackPanel Spacing="14">
          <TextBlock Text="My account" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*">
                <c:AvatarView Width="72" Height="72" DisplayName="{Binding DisplayName}" Color="{Binding AvatarColor}" Image="{Binding Me.AvatarImage}" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" Classes="h2" />
                  <TextBlock Text="{Binding Me.Username, StringFormat='@{0}'}" Classes="muted" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Classes="ghost" Command="{Binding ChangePhotoCommand}" IsEnabled="{Binding !IsBusy}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Data="{StaticResource IconImage}" Width="15" Height="15" />
                        <TextBlock Text="Change photo" />
                      </StackPanel>
                    </Button>
                    <Button Classes="link" Content="Remove photo" Command="{Binding RemovePhotoCommand}" VerticalAlignment="Center"
                            IsVisible="{Binding Me.AvatarImage, Converter={x:Static ObjectConverters.IsNotNull}}" IsEnabled="{Binding !IsBusy}" />
                    <TextBlock Text="{Binding PhotoMessage}" VerticalAlignment="Center" FontSize="12.5"
                               Classes="status" Classes.error="{Binding PhotoError}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
              <StackPanel>
                <TextBlock Text="DISPLAY NAME" Classes="label" />
                <TextBox Text="{Binding DisplayName}" MaxLength="32" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="AVATAR COLOUR" Classes="label" />
                <ItemsControl ItemsSource="{Binding Palette}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="bare" Margin="0,0,8,8" Cursor="Hand"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickColorCommand}"
                              CommandParameter="{Binding}">
                        <Ellipse Width="30" Height="30" Fill="{Binding Converter={x:Static views:Converters.ColorToBrush}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="CUSTOM STATUS" Classes="label" />
                <Grid ColumnDefinitions="64,*">
                  <TextBox Text="{Binding StatusEmoji}" MaxLength="16" Watermark="😀" HorizontalContentAlignment="Center"
                           ToolTip.Tip="An emoji shown before your status" />
                  <TextBox Grid.Column="1" Text="{Binding StatusText}" MaxLength="64" Margin="8,0,0,0" Watermark="What are you up to?" />
                </Grid>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="ABOUT ME" Classes="label" />
                <TextBox Text="{Binding Bio}" MaxLength="190" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                         Watermark="A few words about you, shown on your profile card" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="NAME COLOUR" Classes="label" />
                <WrapPanel>
                  <Button Classes="bare" Margin="0,0,8,8" Command="{Binding PickNameColorCommand}" CommandParameter="{x:Null}"
                          ToolTip.Tip="The theme's colour">
                    <Border Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource TextMutedBrush}">
                      <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                  <ItemsControl ItemsSource="{Binding NamePalette}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="bare" Margin="0,0,8,8" Cursor="Hand"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickNameColorCommand}"
                                CommandParameter="{Binding}">
                          <Ellipse Width="30" Height="30" Fill="{Binding Converter={x:Static views:Converters.ColorToBrush}}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
                <TextBlock Text="{Binding DisplayName}" Foreground="{Binding NamePreview}" FontWeight="SemiBold" FontSize="15" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="PROFILE BANNER" Classes="label" />
                <WrapPanel>
                  <Button Classes="bare" Margin="0,0,8,8" Command="{Binding PickBannerColorCommand}" CommandParameter="{x:Null}"
                          ToolTip.Tip="Same as the avatar colour">
                    <Border Width="30" Height="30" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource TextMutedBrush}"
                            Background="{Binding AvatarColor, Converter={x:Static views:Converters.ColorToBrush}}" />
                  </Button>
                  <ItemsControl ItemsSource="{Binding Palette}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="bare" Margin="0,0,8,8" Cursor="Hand"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickBannerColorCommand}"
                                CommandParameter="{Binding}">
                          <Border Width="30" Height="30" CornerRadius="6" Background="{Binding Converter={x:Static views:Converters.ColorToBrush}}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
                <Border Height="18" CornerRadius="4" Background="{Binding BannerPreview}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="primary" Content="Save profile" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="{Binding ProfileMessage}" VerticalAlignment="Center"
                           Classes="status" Classes.error="{Binding ProfileError}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Spacing="14">
          <TextBlock Text="Appearance" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="10">
              <TextBlock Text="THEME" Classes="label" Margin="0" />
              <ListBox Classes="tiles" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Margin="-6,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <StackPanel Width="134" Spacing="6">
                      <Border Height="74" CornerRadius="4" ClipToBounds="True" Background="{Binding Window}"
                              BorderBrush="{Binding Border}" BorderThickness="1">
                        <Grid RowDefinitions="16,*" ColumnDefinitions="36,*">
                          <Border Grid.ColumnSpan="2" Background="{Binding Header}" />
                          <Border Grid.Row="1" Background="{Binding Sidebar}" />
                          <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,7,7,6" Spacing="5">
                            <Border Height="5" Width="64" HorizontalAlignment="Left" CornerRadius="2.5" Background="{Binding Text}" Opacity="0.85" />
                            <Border Height="5" Width="44" HorizontalAlignment="Left" CornerRadius="2.5" Background="{Binding Text}" Opacity="0.5" />
                            <Border Height="13" Width="38" HorizontalAlignment="Right" CornerRadius="3" Background="{Binding Accent}" Margin="0,4,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="ACCENT COLOUR" Classes="label" Margin="0,6,0,0" />
              <WrapPanel>
                <Button Classes="bare" Margin="0,0,8,8" Command="{Binding PickAccentCommand}" CommandParameter="{x:Null}"
                        ToolTip.Tip="The theme's colour">
                  <Border Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource TextMutedBrush}">
                    <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Button>
                <ItemsControl ItemsSource="{Binding AccentPalette}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="bare" Margin="0,0,8,8" Cursor="Hand"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickAccentCommand}"
                              CommandParameter="{Binding}">
                        <Ellipse Width="30" Height="30" Fill="{Binding Converter={x:Static views:Converters.ColorToBrush}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="MESSAGE TEXT SIZE" Classes="label" Margin="0" />
                <TextBlock Grid.Column="1" Text="{Binding MessageFontSizeText}" Classes="secondary" FontSize="12" />
              </Grid>
              <Slider Minimum="12" Maximum="20" Value="{Binding MessageFontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ZOOM" Classes="label" Margin="0" />
                <TextBlock Grid.Column="1" Text="{Binding ZoomText}" Classes="secondary" FontSize="12" />
              </Grid>
              <Slider Minimum="80" Maximum="150" Value="{Binding ZoomPercent}" TickFrequency="10" IsSnapToTickEnabled="True" />
              <CheckBox IsChecked="{Binding CompactMessages}" Content="Compact messages (smaller avatars, less space)" />
              <Button Classes="link" Content="Reset appearance" Command="{Binding ResetAppearanceCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Notifications -->
        <StackPanel Spacing="14">
          <TextBlock Text="Notifications" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="10">
              <CheckBox IsChecked="{Binding MessageSounds}" Content="Play a sound when a message arrives" />
              <CheckBox IsChecked="{Binding MentionSounds}" Content="Always play it when someone @mentions me" />
              <CheckBox IsChecked="{Binding TaskbarAlerts}" Content="Flash the taskbar when a message arrives" />
              <CheckBox IsChecked="{Binding CallSounds}" Content="Play sounds when people join or leave the call" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Message sounds and alerts come when Discagem is in the background or the message is in another channel, never while deafened. To hear less from a room or a channel, right-click it and choose Notifications." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Password -->
        <StackPanel Spacing="14">
          <TextBlock Text="Password" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="12">
              <StackPanel>
                <TextBlock Text="CURRENT PASSWORD" Classes="label" />
                <TextBox Text="{Binding CurrentPassword}" PasswordChar="•" />
              </StackPanel>
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel>
                  <TextBlock Text="NEW PASSWORD" Classes="label" />
                  <TextBox Text="{Binding NewPassword}" PasswordChar="•" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="CONFIRM NEW PASSWORD" Classes="label" />
                  <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Change password" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="{Binding PasswordMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                           Classes="status" Classes.error="{Binding PasswordError}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Voice -->
        <StackPanel Spacing="14">
          <TextBlock Text="Voice &amp; audio" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel>
                  <TextBlock Text="INPUT DEVICE" Classes="label" />
                  <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputDevice}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="audio:AudioDeviceInfo">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="OUTPUT DEVICE" Classes="label" />
                  <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDevice}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="audio:AudioDeviceInfo">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="INPUT SENSITIVITY" Classes="label" />
                  <TextBlock Grid.Column="1" Text="{Binding ThresholdText}" Classes="caption" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding InputLevelPercent}" Height="6" MinHeight="6"
                             CornerRadius="3" Margin="6,0" Classes="meter" Classes.active="{Binding IsAboveThreshold}" />
                <Slider Minimum="-80" Maximum="0" Value="{Binding ThresholdDb}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="Speak normally: the bar turns green when others would hear you. Move the slider right if background noise turns it green." />
                  <Button Grid.Column="1" Content="{Binding MicrophoneTestText}" Command="{Binding ToggleMicrophoneTestCommand}"
                          IsVisible="{Binding CanTestMicrophone}" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="OUTPUT VOLUME" Classes="label" />
                  <TextBlock Grid.Column="1" Text="{Binding OutputVolumeText}" Classes="caption" />
                </Grid>
                <Slider Minimum="0" Maximum="200" Value="{Binding OutputVolumePercent}" TickFrequency="5" IsSnapToTickEnabled="True" />
              </StackPanel>

              <StackPanel Spacing="2">
                <TextBlock Text="{Binding EchoAdvice}" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AudioSystem}" Classes="caption" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Streaming -->
        <StackPanel Spacing="14">
          <TextBlock Text="Screen sharing" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="12">
              <StackPanel>
                <TextBlock Text="DEFAULT QUALITY" Classes="label" />
                <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding DefaultQuality}" Width="240">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="media:StreamQuality">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <TextBlock Text="{Binding CodecInfo}" Classes="caption" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- App -->
        <StackPanel Spacing="14">
          <TextBlock Text="App" Classes="h2" />
          <Border Classes="section-card">
            <StackPanel Spacing="6">
              <CheckBox IsChecked="{Binding CloseToTray}" Content="Keep running in the notification area when the window is closed" />
              <TextBlock Text="{Binding TrayHint}" Classes="caption" TextWrapping="Wrap" Margin="28,0,0,0" />
              <CheckBox IsChecked="{Binding CheckForUpdatesAutomatically}" Content="Check for updates automatically" Margin="0,10,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="28,2,0,0">
                <Button Classes="ghost" Content="Check now" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingForUpdates}" />
                <TextBlock Text="{Binding UpdateStatus}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- About -->
        <StackPanel Spacing="6">
          <TextBlock Text="About" Classes="h2" Margin="0,0,0,8" />
          <TextBlock Classes="secondary">
            <Run Text="Server: " /><Run Text="{Binding ServerName}" FontWeight="SemiBold" />
          </TextBlock>
          <TextBlock Text="{Binding ServerAddress}" Classes="caption" />
          <TextBlock Text="{Binding AppVersion, StringFormat='Discagem desktop {0}'}" Classes="caption" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="link" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
            <TextBlock Text="{Binding LogFolder}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="danger" Command="{Binding LogoutCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource IconLogout}" Width="16" Height="16" />
            <TextBlock Text="Log out" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="ghost" Content="Close" Click="OnClose" IsCancel="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
