<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Discagem.Client.ViewModels"
        xmlns:c="using:Discagem.Client.Controls"
        xmlns:media="using:Discagem.Media.Pipeline"
        xmlns:r="using:Discagem.Client.Resources"
        x:Class="Discagem.Client.Views.Dialogs.ScreenPickerDialog"
        x:DataType="vm:ScreenPickerViewModel"
        Width="780" Height="640" MinWidth="560" MinHeight="480" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ChatBrush}"
        Title="{x:Static r:Strings.Picker_Title}">

  <Window.Resources>
    <DataTemplate x:Key="TileTemplate" x:DataType="vm:CaptureTileViewModel">
      <StackPanel Width="208" Spacing="6">
        <Border Width="208" Height="117" CornerRadius="6" Background="#0B0B0E" ClipToBounds="True">
          <Panel>
            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <c:Icon Data="{StaticResource IconMonitor}" Width="34" Height="34" Foreground="{DynamicResource TextMutedBrush}"
                    IsVisible="{Binding !HasThumbnail}" />
          </Panel>
        </Border>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding SizeLabel}" Classes="caption" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="24,20,24,8" Spacing="4">
      <TextBlock Text="{x:Static r:Strings.Picker_Title}" Classes="h2" FontSize="20" />
      <TextBlock Text="{x:Static r:Strings.Picker_Subtitle}"
                 Classes="secondary" TextWrapping="Wrap" />
    </StackPanel>

    <Panel Grid.Row="1" Margin="16,4,16,0">
      <TabControl IsVisible="{Binding IsSupported}" Padding="0,8,0,0">
        <TabItem Header="{x:Static r:Strings.Picker_ScreensTab}">
          <ListBox Classes="tiles" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                   ItemTemplate="{StaticResource TileTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </TabItem>
        <TabItem Header="{x:Static r:Strings.Picker_ApplicationsTab}" IsVisible="{Binding SupportsWindows}">
          <ListBox Classes="tiles" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}"
                   ItemTemplate="{StaticResource TileTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </TabItem>
      </TabControl>

      <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="160" Height="3" MinHeight="3" Foreground="{DynamicResource AccentBrush}"
                   IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />

      <StackPanel IsVisible="{Binding !IsSupported}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
        <c:Icon Data="{StaticResource IconMonitor}" Width="48" Height="48" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Text="{Binding UnsupportedReason}" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Panel>

    <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="24,16">
      <Grid ColumnDefinitions="*,16,200" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Text="{x:Static r:Strings.Picker_StreamTitleLabel}" Classes="label" />
        <TextBox Grid.Row="1" Text="{Binding Title}" MaxLength="64" />
        <TextBlock Grid.Column="2" Text="{x:Static r:Strings.Picker_QualityLabel}" Classes="label" />
        <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}"
                  HorizontalAlignment="Stretch" Height="40">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="media:StreamQuality">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0" IsVisible="{Binding CanShareAudio}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="420" Spacing="2">
          <CheckBox IsChecked="{Binding ShareAudio}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconVolume}" Width="16" Height="16" />
              <TextBlock Text="{x:Static r:Strings.Picker_ShareAudio}" VerticalAlignment="Center" />
            </StackPanel>
          </CheckBox>
          <TextBlock Text="{Binding AudioHint}" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0" Text="{Binding AudioUnavailableReason}" Classes="secondary" FontSize="12"
                   IsVisible="{Binding !CanShareAudio}" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Spacing="10" Margin="0,16,0,0">
          <Button Classes="ghost" Content="{x:Static r:Strings.Picker_Cancel}" Click="OnCancel" IsCancel="True" />
          <Button Classes="live" Click="OnGoLive" IsEnabled="{Binding CanGoLive}" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{StaticResource IconScreenShare}" Width="18" Height="18" />
              <TextBlock Text="{x:Static r:Strings.Picker_GoLive}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
