<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Discagem.Client.ViewModels"
             x:Class="Discagem.Client.Views.SplashView"
             x:DataType="vm:SplashViewModel"
             Background="{DynamicResource LoginBackground}">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
    <Border Classes="brand-tile" Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center">
      <Viewbox Margin="10">
        <Canvas Width="24" Height="24">
          <Path Data="{StaticResource LogoBubble}" Fill="White" />
          <Path Data="{StaticResource LogoPlay}" Fill="{DynamicResource LogoAccentBrush}" />
        </Canvas>
      </Viewbox>
    </Border>
    <ProgressBar IsIndeterminate="True" Width="160" Height="4" MinHeight="4" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock Text="{Binding Message}" Classes="secondary" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
